{
  "name": "teaching-workspace",
  "version": "1.10.1",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "desktop:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env TEACHING_DEV=1 electron .\"",
    "package:mac": "npm run build && node scripts/make-icons.mjs && node scripts/package-mac.mjs",
    "install:mac": "npm run build && node scripts/make-icons.mjs && node scripts/package-mac.mjs --install",
    "test": "node --test tests/*.test.*",
    "test:e2e": "playwright test",
    "test:packaged": "node scripts/smoke-packaged.mjs",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.15",
    "docx": "^9.5.0",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "katex": "^0.19.1",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.11.0",
    "pdfjs-dist": "^6.5.438",
    "pinyin-pro": "^3.27.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.56.1",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^45.3.3",
    "prettier": "^3.6.2",
    "vite": "^7.2.0",
    "wait-on": "^9.0.3"
  },
  "overrides": {
    "katex": "^0.19.1",
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
